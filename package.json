{
  "name": "notifycli",
  "version": "0.0.1",
  "description": "Unified notification system CLI for testing and sending notifications through external messaging providers",
  "license": "MIT",
  "type": "module",
  "bin": {
    "notifycli": "dist/cli.js"
  },
  "scripts": {
    "build": "bunup && chmod +x dist/cli.js",
    "dev": "bunup --watch",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "biome check . && eslint .",
    "lint:fix": "biome check --write . && eslint --fix .",
    "release": "bun run build && npm publish --provenance"
  },
  "dependencies": {
    "citty": "^0.2.2",
    "js-yaml": "^4.1.1",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@changesets/cli": "^2.31.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.9.1",
    "@vitest/coverage-v8": "^4.1.7",
    "bunup": "^0.16.31",
    "eslint": "^10.4.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.0",
    "vitest": "^4.1.7"
  }
}
